"""
Reproduit le pipeline du TP2 (régression du prix de vente d'une voiture d'occasion)
et sauvegarde les éléments nécessaires au déploiement dans best_model.joblib /
encoders.joblib.

À lancer une seule fois (en local), AVANT de déployer :
    pip install -r requirements-train.txt
    python train_model.py
"""

import numpy as np
import pandas as pd
import joblib
from sklearn.preprocessing import LabelEncoder
from sklearn.impute import KNNImputer
from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.linear_model import LinearRegression, Ridge, Lasso
from sklearn.tree import DecisionTreeRegressor
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import r2_score, mean_squared_error, mean_absolute_error
from xgboost import XGBRegressor

DATA_PATH = "Car_data.csv"

# 1. Charger les données
df = pd.read_csv(DATA_PATH)

cat_cols = df.select_dtypes(include="object").columns.tolist()
quant_cols = df.select_dtypes(include="number").columns.tolist()

# 2. Encoder les variables catégorielles (Fuel_Type, Seller_Type, Transmission)
encoders = {}
for col in cat_cols:
    enc = LabelEncoder()
    enc.fit(df[col])
    df[col] = enc.transform(df[col])
    encoders[col] = enc

# 3. Imputation des outliers (méthode IQR + KNNImputer), comme dans le notebook
def impute_func(df, col, n_neighbors=5):
    Q1 = df[col].quantile(0.25)
    Q3 = df[col].quantile(0.75)
    IQR = Q3 - Q1
    min_value = Q1 - 1.5 * IQR
    max_value = Q3 + 1.5 * IQR
    df.loc[(df[col] < min_value) | (df[col] > max_value), col] = np.nan
    imputer = KNNImputer(n_neighbors=n_neighbors)
    df[:] = imputer.fit_transform(df)

for col in quant_cols:
    impute_func(df, col)

# 4. Fractionner les données (train / val / test, comme dans le notebook)
x = df.iloc[:, :-1].values
y = df.iloc[:, -1].values
feature_cols = df.columns[:-1].tolist()

x_train, x_vt, y_train, y_vt = train_test_split(x, y, test_size=0.2, random_state=42)
x_val, x_test, y_val, y_test = train_test_split(x_vt, y_vt, test_size=0.5, random_state=42)


def evaluation(model, x_eval=x_val, y_eval=y_val):
    y_pred = model.predict(x_eval)
    return (
        r2_score(y_eval, y_pred),
        mean_squared_error(y_eval, y_pred),
        mean_absolute_error(y_eval, y_pred),
    )


resultats = {}
modeles = {}

# --- Random Forest ---
# Note : la grille d'origine (n_estimators jusqu'à 150) donne un modèle > 25 Mo,
# ce qui dépasse la limite d'upload du navigateur GitHub (25 Mio). On plafonne donc
# n_estimators à 60, qui conserve une précision quasi identique (R2 val : 0.8793 vs 0.8806)
# pour un fichier ~15 Mo au lieu de ~37 Mo. Pousser le fichier complet via `git push`
# (limite 100 Mo) reste possible si on préfère garder n_estimators=150.
params_rf = {"n_estimators": [25, 40, 60], "max_depth": [5, 10, 15, None]}
grid_rf = GridSearchCV(RandomForestRegressor(random_state=42, n_jobs=-1), params_rf, cv=5, scoring="r2", n_jobs=-1)
grid_rf.fit(x_train, y_train)
rf_model = RandomForestRegressor(random_state=42, n_jobs=-1, **grid_rf.best_params_)
rf_model.fit(x_train, y_train)
modeles["Random Forest"] = rf_model
resultats["Random Forest"] = evaluation(rf_model)

# --- XGBoost ---
xgb_model = XGBRegressor(n_estimators=90, max_depth=3, random_state=42)
xgb_model.fit(x_train, y_train)
modeles["XGBoost"] = xgb_model
resultats["XGBoost"] = evaluation(xgb_model)

# --- Linear Regression ---
params_lr = {"fit_intercept": [True, False], "positive": [True, False]}
grid_lr = GridSearchCV(LinearRegression(), params_lr, cv=5)
grid_lr.fit(x_train, y_train)
lr_model = LinearRegression(**grid_lr.best_params_)
lr_model.fit(x_train, y_train)
modeles["Linear Regression"] = lr_model
resultats["Linear Regression"] = evaluation(lr_model)

# --- Ridge ---
params_r = {"alpha": np.logspace(-8, 8, 100)}
grid_rr = GridSearchCV(Ridge(), params_r, cv=5)
grid_rr.fit(x_train, y_train)
rr_model = Ridge(**grid_rr.best_params_)
rr_model.fit(x_train, y_train)
modeles["Ridge Regression"] = rr_model
resultats["Ridge Regression"] = evaluation(rr_model)

# --- Lasso ---
grid_lar = GridSearchCV(Lasso(), params_r, cv=5)
grid_lar.fit(x_train, y_train)
lar_model = Lasso(**grid_lar.best_params_)
lar_model.fit(x_train, y_train)
modeles["Lasso Regression"] = lar_model
resultats["Lasso Regression"] = evaluation(lar_model)

# --- Decision Tree ---
params_dt = {"max_depth": np.arange(1, 15), "criterion": ["squared_error", "absolute_error"]}
grid_dt = GridSearchCV(DecisionTreeRegressor(), params_dt, cv=5)
grid_dt.fit(x_train, y_train)
dt_model = DecisionTreeRegressor(**grid_dt.best_params_)
dt_model.fit(x_train, y_train)
modeles["Decision Tree"] = dt_model
resultats["Decision Tree"] = evaluation(dt_model)

# 5. Comparaison et sélection du meilleur modèle (par R2 de validation)
results_df = pd.DataFrame(
    [{"Modèle": nom, "R2": r2, "MSE": mse, "MAE": mae} for nom, (r2, mse, mae) in resultats.items()]
).sort_values(by="R2", ascending=False).reset_index(drop=True)
print(results_df)

best_model_name = results_df.loc[0, "Modèle"]
best_model = modeles[best_model_name]
print(f"\nModèle le plus performant : {best_model_name} (R2 val = {results_df.loc[0, 'R2']:.4f})")

# 6. Évaluation finale sur le jeu de test
y_pred_test = best_model.predict(x_test)
print(f"R2 test  : {r2_score(y_test, y_pred_test):.4f}")
print(f"MSE test : {mean_squared_error(y_test, y_pred_test):.4f}")
print(f"MAE test : {mean_absolute_error(y_test, y_pred_test):.4f}")

# 7. Sauvegarder le modèle, les encodeurs et les infos nécessaires au déploiement
joblib.dump(best_model, "best_model.joblib")
joblib.dump(encoders, "encoders.joblib")
joblib.dump(
    {"best_model_name": best_model_name, "feature_cols": feature_cols, "results": results_df},
    "model_info.joblib",
)
print("\nSauvegardé : best_model.joblib, encoders.joblib, model_info.joblib")
